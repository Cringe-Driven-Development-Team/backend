# Generate a fresh token: openssl rand -hex 32
RUNTIME_TOKEN=
HOST=127.0.0.1
PORT=8000
# Assigned before starting the service. Never reuse STATE_DIR for another session.
SESSION_ID=
KERNEL_LANGUAGE=python
# Prepared by infra, including firewall; there is no default-network fallback.
KERNEL_NETWORK=cellestial-kernel
KERNEL_DNS=1.1.1.1
IDLE_TIMEOUT_SECONDS=900
MAX_OUTPUT_BYTES=10485760
PYTHON_IMAGE=cellestial-kernel-python:local
R_IMAGE=cellestial-kernel-r:local
